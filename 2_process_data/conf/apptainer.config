// Enable Singularity (or replace 'singularity' with 'apptainer' if your cluster uses Apptainer)
singularity {
    enabled = true
    autoMounts = true
    cacheDir   = '/storage/home/skd6150/.apptainer'  // must be on shared filesystem
    runOptions = "-B \$TMPDIR"   // bind-mount host TMPDIR into container
}

process {
    withLabel: fastq {
        container = "quay.io/biocontainers/fastq-dl:3.0.1--pyhdfd78af_0"
    }

    withLabel: trim_galore {
        container = "quay.io/biocontainers/trim-galore:0.6.5--0"
    }

    withLabel: bowtie {
        container = "quay.io/biocontainers/bowtie:1.2.3--py37hc9558a2_0"
    }

    withName: get_read_direction {
        container = "quay.io/biocontainers/rseqc:3.0.1--py37h516909a_1"
    }

    withName: gff2bed {
        container = "quay.io/biocontainers/bedops:2.4.37--hc9558a2_0"
    }

    withName: multiqc {
        container = "meono/multiqc_modulome:1.11"
    }

    withName: featureCounts {
        container = "quay.io/biocontainers/subread:2.0.1--hed695b0_0"
    }

    withLabel: python {
        container = "avsastry/biopython:1.0"
    }

    withName: sam2bam {
        container = "quay.io/biocontainers/samtools:1.6--h9dace67_6"
    }
}

